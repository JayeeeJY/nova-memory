{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Nova automatic extraction output v0.1",
  "description": "Structural generation constraints only. The unchanged core validates source grounding, semantic payload budgets, times, provenance, authority and transaction state.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "units"],
  "properties": {
    "schema_version": {"type": "string", "const": "nova.extraction.v0.1"},
    "units": {
      "type": "array",
      "minItems": 0,
      "maxItems": 16,
      "items": {"$ref": "#/$defs/unit"}
    }
  },
  "$defs": {
    "json_value": {
      "anyOf": [
        {"type": "null"},
        {"type": "boolean"},
        {"type": "number"},
        {"type": "string"},
        {"type": "array", "items": {"$ref": "#/$defs/json_value"}},
        {"type": "object", "additionalProperties": {"$ref": "#/$defs/json_value"}}
      ]
    },
    "nullable_string": {"type": ["string", "null"]},
    "content": {
      "type": "object",
      "additionalProperties": false,
      "required": ["subject", "predicate", "value", "polarity", "modality", "conditions"],
      "properties": {
        "subject": {"type": "string", "minLength": 1, "maxLength": 240},
        "predicate": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]{0,63}:[a-z][a-z0-9_.-]{0,63}$"},
        "value": {"$ref": "#/$defs/json_value"},
        "polarity": {"type": "string", "enum": ["positive", "negative"]},
        "modality": {"type": "string", "enum": ["asserted", "planned", "hypothetical", "unknown"]},
        "conditions": {"type": "object", "additionalProperties": {"$ref": "#/$defs/json_value"}}
      }
    },
    "valid_time": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": {"kind": {"type": "string", "const": "unknown"}}
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "start"],
          "properties": {
            "kind": {"type": "string", "const": "interval"},
            "start": {"type": "string"},
            "end": {"$ref": "#/$defs/nullable_string"}
          }
        }
      ]
    },
    "quote": {
      "type": "object",
      "additionalProperties": false,
      "required": ["quote", "occurrence"],
      "properties": {
        "quote": {"type": "string", "minLength": 1, "maxLength": 4096},
        "occurrence": {"type": "integer", "minimum": 0, "maximum": 64}
      }
    },
    "unit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["origin", "content", "valid_time", "quotes"],
      "properties": {
        "origin": {"type": "string", "enum": ["extracted", "inferred", "external_claim", "agent_experience"]},
        "content": {"$ref": "#/$defs/content"},
        "occurred_at": {"$ref": "#/$defs/nullable_string"},
        "valid_time": {"$ref": "#/$defs/valid_time"},
        "quotes": {"type": "array", "minItems": 1, "maxItems": 16, "items": {"$ref": "#/$defs/quote"}}
      }
    }
  }
}
